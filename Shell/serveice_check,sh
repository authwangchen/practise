
#!/bin/bash

# ==================== 配置区域 ====================

# 告警阈值，可根据实际业务调整
CPU_THRESHOLD=80
MEM_THRESHOLD=80
DISK_THRESHOLD=80

# 日志文件
LOG_DIR="/data/tool/logs"
LOG_FILE="${LOG_DIR}/server_monitor.log"

# 是否将告警写入系统日志：1=开启，0=关闭
SYSLOG_ENABLED=1

# ==================== 初始化 ====================

mkdir -p "$LOG_DIR" || exit 1

# 获取当前时间
get_time() {
    date '+%Y-%m-%d %H:%M:%S'
}

# 写入日志
write_log() {
    local level="$1"
    local message="$2"

    echo "[$(get_time)] [$level] $message" >> "$LOG_FILE"

    # 超阈值告警时同步写入系统日志
    if [[ "$level" == "ALERT" && "$SYSLOG_ENABLED" -eq 1 ]]; then
        logger -t server_monitor "ALERT: $message" 2>/dev/null || true
    fi
}

# ==================== CPU 监控 ====================

# 读取 CPU 总时间和空闲时间
read_cpu_stat() {
    awk '/^cpu / {
        total = 0
        for (i = 2; i <= 8; i++) {
            total += $i
        }
        idle = $5 + $6
        printf "%.0f %.0f\n", total, idle
    }' /proc/stat
}

get_cpu_usage() {
    local total1 idle1 total2 idle2

    read -r total1 idle1 < <(read_cpu_stat)

    # 间隔 1 秒，计算 CPU 时间变化
    sleep 1

    read -r total2 idle2 < <(read_cpu_stat)

    local total_diff=$((total2 - total1))
    local idle_diff=$((idle2 - idle1))

    if (( total_diff <= 0 )); then
        echo "0.00"
        return
    fi

    awk -v total="$total_diff" -v idle="$idle_diff" \
        'BEGIN {
            printf "%.2f", (total - idle) * 100 / total
        }'
}

check_cpu() {
    local usage
    usage=$(get_cpu_usage)

    write_log "INFO" "CPU使用率: ${usage}%"

    if awk -v u="$usage" -v t="$CPU_THRESHOLD" \
        'BEGIN { exit !(u >= t) }'; then
        write_log "ALERT" \
            "CPU使用率超过阈值！当前=${usage}%，阈值=${CPU_THRESHOLD}%"
    fi
}

# ==================== 内存监控 ====================

get_mem_usage() {
    free | awk '/^Mem:/ {
        if ($2 > 0) {
            printf "%.2f", ($2 - $7) * 100 / $2
        } else {
            print "0.00"
        }
    }'
}

check_mem() {
    local usage
    usage=$(get_mem_usage)

    if [[ -z "$usage" ]]; then
        write_log "ERROR" "获取内存使用率失败"
        return
    fi

    write_log "INFO" "内存使用率: ${usage}%"

    if awk -v u="$usage" -v t="$MEM_THRESHOLD" \
        'BEGIN { exit !(u >= t) }'; then
        write_log "ALERT" \
            "内存使用率超过阈值！当前=${usage}%，阈值=${MEM_THRESHOLD}%"
    fi
}

# ==================== 磁盘监控 ====================

check_disk() {
    local found=0

    # 排除内存文件系统和只读镜像文件系统
    while read -r filesystem size used avail usep mountpoint; do
        [[ "$usep" =~ ^[0-9]+%$ ]] || continue

        local usage="${usep%\%}"
        found=1

        write_log "INFO" \
            "磁盘使用率: 挂载点=${mountpoint}，使用率=${usage}%"

        if (( usage >= DISK_THRESHOLD )); then
            write_log "ALERT" \
                "磁盘使用率超过阈值！挂载点=${mountpoint}，当前=${usage}%，阈值=${DISK_THRESHOLD}%"
        fi
    done < <(df -P -x tmpfs -x devtmpfs -x squashfs 2>/dev/null |
             awk 'NR > 1')

    if (( found == 0 )); then
        write_log "ERROR" "未获取到有效的磁盘使用数据"
    fi
}

# ==================== 主程序 ====================

write_log "INFO" "========== 开始服务器资源监控 =========="

check_cpu
check_mem
check_disk

write_log "INFO" "========== 本次监控结束 =========="
